# ETL 스크립트(scripts/etl)에서 사용하는 무료 공개 API 키
# 실제 키는 .env 에 넣고 커밋하지 말 것 (.gitignore 처리)

# 한국은행 ECOS  https://ecos.bok.or.kr  (기준금리·대출금리·가계대출·건설공사비)
ECOS_API_KEY=

# 공공데이터포털  https://www.data.go.kr  (청약홈 등)
DATA_GO_KR_KEY=

# KOSIS 통계정보  https://kosis.kr/openapi  (인허가·착공·준공·미분양·거래량·공사비)
# 없으면 DATA_GO_KR_KEY로 폴백 시도. (KOSIS는 별도 키 발급 권장)
KOSIS_API_KEY=

# 부동산원 R-ONE  https://www.reb.or.kr  (매매·전세 가격지수)
REB_RONE_KEY=
